# Section 1 - Helper functions
import turtle, time, random
def set_background(image_filename):
    screen = turtle.Screen()
    try:
        screen.bgpic(f"/workspaces/Computational-Thinking-8/Backgrounds/{image_filename}.png")
    except:
        screen.bgpic(f"/workspaces/Computational-Thinking-8/Backgrounds/{image_filename}.gif")
def create_sprite(image_filename, x=0, y=0):
    image_file = f"/workspaces/Computational-Thinking-8/Images/{image_filename}.gif"
    screen = turtle.Screen()
    screen.register_shape(image_file)
    sprite = turtle.Turtle()
    sprite.shape(image_file)
    sprite.penup()
    sprite.goto(x,y)
    return sprite


# Section 2 - Variables
# TODO - add starting values for all the variables
x1 = -100
y1 = 100
x2 = -100
y2 = 200
x3 = -100
y3 = -100
x4 = -100
y4 = -200

# Section 3 - Setup
set_background("summer")
t1 = create_sprite("gymnast 2",x1,y1)
t2 = create_sprite("Winnie the pooh",x2,y2)
t3 = create_sprite("panda 2",x3,y3)
t4 = create_sprite("basketball",x4,y4)


# Section 4 - Racing
# the panda is the most likly to got the fastest because it has the biggest numbers
for i in range(30):
    x1 += random.randint(3,19)
    x2 += random.randint(1,18)
